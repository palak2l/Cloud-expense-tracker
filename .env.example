# Copy this file to .env and fill in values for your environment.
# Never commit a real .env file or AWS credentials.

NODE_ENV=development
PORT=3000

# Strong random string used to sign session cookies (generate with: openssl rand -hex 32)
SESSION_SECRET=replace-with-a-long-random-secret

# SQLite database file path
DATABASE_PATH=./data/expense-tracker.sqlite

# Cookie settings: set COOKIE_SECURE=true when serving over HTTPS in production
COOKIE_SECURE=false
COOKIE_SAMESITE=lax

# Public origin of this app (used for CSRF origin checks in production)
APP_ORIGIN=http://localhost:3000

# Storage: "local" for development without AWS; "s3" for production on EC2
STORAGE_DRIVER=local
UPLOAD_DIR=./uploads

# --- Amazon S3 (required when STORAGE_DRIVER=s3) ---
# Do NOT put access keys here on EC2. Use an IAM instance role instead.
# Local development may use temporary keys; never commit them.
AWS_REGION=ap-south-1
S3_BUCKET_NAME=REPLACE_WITH_YOUR_PRIVATE_BUCKET_NAME
# Optional local-only credentials (leave unset on EC2 with an instance role)
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=

# Receipt limits
MAX_RECEIPT_BYTES=5242880
